# Supabase connection for shared study notes.
#
# Copy this file to `.env.local` (gitignored) for local development, and add the
# same two variables to the Vercel project (Settings → Environment Variables) for
# production. Both come from the Supabase dashboard:
#   Project Settings → API → Project URL and Project API keys.
#
# The app reads VITE_SUPABASE_ANON_KEY. Either the classic "anon" key or the
# newer "publishable" key (sb_publishable_…) works here — both are public keys
# that are safe to expose in the frontend. Row Level Security (RLS) on the notes
# tables is what actually protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
